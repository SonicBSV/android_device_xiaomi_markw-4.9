<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay for Xiaomi Redmi 4 Prime (markw)
  LineageOS 22.2 / Android 15
-->
<resources>
    <!-- Навигация (аппаратные кнопки) -->
    <bool name="config_useDeadZone">false</bool>
    <integer name="navigation_bar_deadzone_hold">0</integer>
    <integer name="navigation_bar_deadzone_decay">0</integer>
    <bool name="config_dead_zone_flash">false</bool>
    <bool name="config_navigation_bar_enable_auto_dim_no_visible_wallpaper">false</bool>

    <!-- Биометрия: отключаем подэкранный и боковой дактилоскоп -->
    <string name="config_udfpsIcon" translatable="false"></string>
    <integer name="config_udfpsDeviceEntryIconLongPress">0</integer>
    <bool name="config_show_sidefps_hint_on_bouncer">false</bool>
    <integer name="config_sfpsSensorWidth">0</integer>
    <bool name="config_restToUnlockSupported">false</bool>
    <integer name="config_restToUnlockDurationScreenOff">0</integer>
    <integer name="config_restToUnlockDurationDefault">0</integer>

    <!-- Face Unlock: не используется -->
    <integer-array name="config_face_auth_props" translatable="false">
        <item>0</item><item>0</item><item>0</item>
    </integer-array>
    <integer-array name="config_inner_face_auth_props" translatable="false">
        <item>0</item><item>0</item><item>0</item>
    </integer-array>

    <!-- Защита выреза камеры — экран без вырезов -->
    <bool name="config_enableDisplayCutoutProtection">false</bool>
    <string translatable="false" name="config_frontBuiltInDisplayCutoutProtection"></string>
    <string translatable="false" name="config_innerBuiltInDisplayCutoutProtection"></string>
    <string translatable="false" name="config_protectedCameraId"></string>
    <string translatable="false" name="config_protectedInnerCameraId"></string>
    <string translatable="false" name="config_protectedPhysicalCameraId"></string>
    <string translatable="false" name="config_protectedInnerPhysicalCameraId"></string>
    <string translatable="false" name="config_protectedScreenUniqueId"></string>
    <string translatable="false" name="config_protectedInnerScreenUniqueId"></string>
    <string translatable="false" name="config_cameraProtectionExcludedPackages"></string>

    <!-- Скругление углов: плоский экран, радиус 0 -->
    <string name="config_rounded_mask" translatable="false">M0,0 C0,0 0,0 0,0 Z</string>

    <!-- Быстрые настройки под 5" FHD -->
    <integer name="quick_qs_panel_max_tiles">4</integer>
    <integer name="quick_qs_panel_max_rows">2</integer>
    <integer name="quick_settings_num_columns">2</integer>
    <integer name="quick_settings_max_rows">4</integer>
    <bool name="config_use_split_notification_shade">false</bool>
    <bool name="force_config_use_split_notification_shade">false</bool>
    <bool name="config_use_large_screen_shade_header">false</bool>

    <!-- Отключаем функции для больших экранов -->
    <bool name="config_enableDesktopFeatureSet">false</bool>
    <bool name="config_userSwitchingMustGoThroughLoginScreen">false</bool>

    <!-- Положение кнопки поворота (по вкусу) -->
    <bool name="floating_rotation_button_position_left">true</bool>

    <!-- Сетка панели управления / Power Menu Lite -->
    <integer name="controls_max_columns">2</integer>
    <integer name="power_menu_lite_max_columns">2</integer>
    <integer name="power_menu_lite_max_rows">4</integer>
</resources>
