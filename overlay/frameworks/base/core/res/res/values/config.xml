    <!-- Sustained Performance Mode.
         ОТКЛЮЧЕНО: Snapdragon 625 не имеет реального sustained mode,
         эта опция просто блокирует частоты на среднем уровне,
         что снижает пиковую производительность без реальной пользы -->
    <bool name="config_sustainedPerformanceModeSupported">false</bool>

    <!-- Boost Framework.
         ОТКЛЮЧЕНО: на Snapdragon 625 с 3GB RAM Qualcomm Boost Framework
         создаёт больше проблем чем решает:
         - Постоянный сервис в памяти (~15-20MB)
         - Агрессивные CPU boosts истощают батарею
         - На SD625 нет performance cores для буста
         - Планировщик ядра справляется лучше -->
    <bool name="config_supportsBoostFramework">false</bool>

    <!-- Shell работает в отдельном потоке -->
    <bool name="config_enableShellMainThread">true</bool>

    <!-- Не показывать сообщение о несоответствии vendor -->
    <bool name="config_show_vendor_mismatch_message">false</bool>

    <!-- Активные broadcast пакеты -->
    <bool name="config_allowActivePackageBroadcast">true</bool>

    <!-- ======================== -->
    <!-- AUTOFILL И СЕНСОРЫ       -->
    <!-- ======================== -->

    <!-- Autofill через Google -->
    <string name="config_defaultAutofillService" translatable="false">com.google.android.gms/.autofill.service.AutofillService</string>

    <!-- Датчик цветовой температуры окружения (для white balance) -->
    <string name="config_displayWhiteBalanceColorTemperatureSensorName">com.google.sensor.color</string>

    <!-- ======================== -->
    <!-- APP LOCK                 -->
    <!-- ======================== -->

    <!-- Системные приложения для блокировки.
         СОКРАЩЁН: убраны приложения которых нет на LineageOS по умолчанию
         (Google Camera, Gallery Go, Docs, Duo, Recorder, Keep, Drive,
          Camera Go, Chrome, GBoard, Maps, Google Quick Search).
         Оставлены только реально присутствующие или часто устанавливаемые.
         Меньший массив = быстрее парсинг при каждой проверке App Lock -->
    <string-array name="config_appLockAllowedSystemApps" translatable="false">
        <!-- Files / DocumentsUI -->
        <item>com.google.android.documentsui</item>
        <!-- Play Store -->
        <item>com.android.vending</item>
        <!-- Google Photos -->
        <item>com.google.android.apps.photos</item>
        <!-- Gmail -->
        <item>com.google.android.gm</item>
        <!-- Youtube -->
        <item>com.google.android.youtube</item>
        <!-- Chrome -->
        <item>com.android.chrome</item>
        <!-- Contacts -->
        <item>com.google.android.contacts</item>
        <!-- Dialer -->
        <item>com.google.android.dialer</item>
        <!-- Messages -->
        <item>com.google.android.apps.messaging</item>
        <!-- Settings -->
        <item>com.android.settings</item>
        <!-- Metro (LineageOS music) -->
        <item>io.github.muntashirakon.Music</item>
        <!-- Files Go -->
        <item>com.google.android.apps.nbu.files</item>
    </string-array>

</resources>
