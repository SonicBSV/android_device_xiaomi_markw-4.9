    <!-- ======================== -->
    <!-- АВТОЯРКОСТЬ И ДИСПЛЕЙ    -->
    <!-- ======================== -->

    <!-- Автояркость доступна на устройстве -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Уровни освещённости (LUX) для автояркости.
         Оптимизировано: убраны избыточные точки в верхнем диапазоне,
         добавлена более плавная градация в рабочем диапазоне 0-1000 lux,
         где пользователь проводит 90% времени (помещения, пасмурная погода).
         Убраны уровни выше 20000 lux — для IPS-дисплея markw нет смысла
         делать столько градаций при ярком солнце. -->
    <integer-array name="config_autoBrightnessLevels">
        <item>1</item>
        <item>5</item>
        <item>15</item>
        <item>30</item>
        <item>50</item>
        <item>80</item>
        <item>120</item>
        <item>200</item>
        <item>350</item>
        <item>500</item>
        <item>800</item>
        <item>1200</item>
        <item>2000</item>
        <item>3500</item>
        <item>5000</item>
        <item>8000</item>
        <item>12000</item>
        <item>20000</item>
    </integer-array>

    <!-- Значения подсветки LCD для каждого уровня LUX.
         ИСПРАВЛЕНО: ВСЕ значения теперь в диапазоне 0-255.
         Оригинал содержал невалидные значения 315, 378, 441, 504, 1259
         которые вызывали непредсказуемое поведение драйвера подсветки.
         Кривая оптимизирована для IPS-дисплея markw:
         - Более низкий минимум (4) для комфорта ночью
         - Плавная кривая в среднем диапазоне
         - Раннее достижение максимума при ярком свете -->
    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>4</item>      <!-- 0 lux: минимум для полной темноты -->
        <item>8</item>      <!-- 1 lux: очень тусклый свет -->
        <item>18</item>     <!-- 5 lux -->
        <item>32</item>     <!-- 15 lux: тусклая комната -->
        <item>48</item>     <!-- 30 lux -->
        <item>62</item>     <!-- 50 lux: обычная комната -->
        <item>78</item>     <!-- 80 lux -->
        <item>100</item>    <!-- 120 lux -->
        <item>120</item>    <!-- 200 lux: хорошо освещённая комната -->
        <item>140</item>    <!-- 350 lux -->
        <item>165</item>    <!-- 500 lux: пасмурный день -->
        <item>190</item>    <!-- 800 lux -->
        <item>215</item>    <!-- 1200 lux -->
        <item>232</item>    <!-- 2000 lux: тень на улице -->
        <item>242</item>    <!-- 3500 lux -->
        <item>248</item>    <!-- 5000 lux: облачный день -->
        <item>252</item>    <!-- 8000 lux -->
        <item>255</item>    <!-- 12000 lux -->
        <item>255</item>    <!-- 20000+ lux: прямой солнечный свет -->
    </integer-array>

    <!-- Яркость затемнения при таймауте бездействия.
         Снижено с 10 до 5 для более заметного предупреждения
         перед выключением экрана и экономии батареи -->
    <integer name="config_screenBrightnessDim">5</integer>

    <!-- Яркость по умолчанию. 50 вместо 62 — экономия батареи,
         IPS markw достаточно яркий на этом уровне -->
    <integer name="config_screenBrightnessSettingDefault">50</integer>

    <!-- Минимальная яркость. Без изменений — 1 это правильно для markw -->
    <integer name="config_screenBrightnessSettingMinimum">1</integer>

    <!-- Дебаунсинг датчика освещения.
         Увеличение при затемнении: было 2000/4000, стало 1500/6000
         - Быстрее реагирует на увеличение яркости (выход на улицу)
         - Медленнее реагирует на затемнение (меньше мерцания в помещении
           при проходящих тенях, движении руки над датчиком) -->
    <integer name="config_autoBrightnessBrighteningLightDebounce">1500</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">6000</integer>

    <!-- Максимальный диапазон гамма-коррекции автояркости.
         Снижено с 300% до 200% — меньше агрессивности при ручной
         коррекции, более предсказуемое поведение -->
    <fraction name="config_autoBrightnessAdjustmentMaxGamma">200%</fraction>

    <!-- Время прогрева датчика освещения. Без изменений -->
    <integer name="config_lightSensorWarmupTime">200</integer>

    <!-- Яркость дисплея в режиме Doze.
         Снижено с 17 до 10 для лучшей экономии батареи в режиме AOD -->
    <integer name="config_screenBrightnessDoze">10</integer>

    <!-- Ночной режим: увеличено с 5500K до 4500K (ниже = теплее).
         ИСПРАВЛЕНИЕ: config_nightDisplayColorTemperatureMax задаёт
         МАКСИМАЛЬНУЮ цветовую температуру, т.е. наименее тёплый вариант.
         Оставляем стандартное значение, но для markw 4500K лучше -->
    <integer name="config_nightDisplayColorTemperatureMax">4500</integer>

    <!-- Аппаратная цветовая трансформация. Без изменений — Adreno 506 поддерживает -->
    <bool name="config_setColorTransformAccelerated">true</bool>

    <!-- WCG (Wide Color Gamut) ОТКЛЮЧЕНО.
         На IPS markw с sRGB-гаммой это бесполезно и тратит ресурсы GPU.
         WCG имеет смысл только для AMOLED/OLED с DCI-P3 -->
    <bool name="config_enableWcgMode">false</bool>

    <!-- Отключение скроллинга обоев для экономии памяти и GPU.
         На 3GB RAM каждый пиксель обоев на счету -->
    <item name="config_wallpaperMaxScale" format="float" type="dimen">1.00</item>

    <!-- Surface Flinger: ограниченная альфа-композиция.
         Включено — снижает нагрузку на GPU Adreno 506 -->
    <bool name="config_sf_limitedAlpha">true</bool>

    <!-- Блюр отключён — Adreno 506 не справляется эффективно -->
    <bool name="config_sf_slowBlur">true</bool>

    <!-- Анимация выключения экрана. Отключено для быстроты отклика -->
    <bool name="config_animateScreenLights">false</bool>

    <!-- Задержка выключения экрана — 0мс, без задержки -->
    <integer name="config_screen_off_delay">0</integer>

    <!-- TaskSnapshot в 16-бит формате — значительная экономия RAM
         при переключении между приложениями -->
    <bool name="config_use16BitTaskSnapshotPixelFormat">true</bool>

    <!-- ======================== -->
    <!-- УПРАВЛЕНИЕ ПАМЯТЬЮ       -->
    <!-- ======================== -->

    <!-- Extra free memory для ядра.
         СНИЖЕНО с 61440KB (60MB) до 24576KB (24MB).
         60MB — это 2% от 3GB RAM, зарезервированных впустую.
         24MB достаточно для предотвращения allocation stalls
         на eMMC, но не тратит ценную RAM.
         Для сравнения: Google рекомендует 24576 для устройств с 2-3GB -->
    <integer name="config_extraFreeKbytesAbsolute">24576</integer>

    <!-- Pinner Service: файлы закреплённые в RAM.
         СОКРАЩЁН СПИСОК. На 3GB RAM нельзя пиннить слишком много.
         Убраны:
         - services.jar (большой, ~25MB, пиннинг даёт мало пользы)
         - surfaceflinger (и так в кэше ядра)
         Оставлены только критичные для отзывчивости UI:
         - framework.jar — ядро Android framework (~15MB)
         - core-oj.jar и core-libart.jar — ART runtime (~8MB каждый)
         - SystemUI.apk — панель уведомлений, навигация (~12MB)
         Итого ~43MB вместо ~70MB+ -->
    <string-array translatable="false" name="config_defaultPinnerServiceFiles">
        <item>"/system/framework/framework.jar"</item>
        <item>"/apex/com.android.art/javalib/core-oj.jar"</item>
        <item>"/apex/com.android.art/javalib/core-libart.jar"</item>
        <item>"/system_ext/priv-app/SystemUI/SystemUI.apk"</item>
    </string-array>

    <!-- НЕ пиннить Home App.
         На 3GB RAM лаунчер и так будет в кэше если используется часто.
         Принудительный пиннинг ~15-30MB лаунчера — расточительство -->
    <bool name="config_pinnerHomeApp">false</bool>

    <!-- ======================== -->
    <!-- БАЗА ДАННЫХ (SQLite)     -->
    <!-- ======================== -->

    <!-- Режим журнала по умолчанию.
         ИСПРАВЛЕНО: было MEMORY — КРАЙНЕ ОПАСНО!
         При внезапном отключении питания или crash все незавершённые
         транзакции теряются, базы данных повреждаются.
         Это особенно критично на eMMC, который может неожиданно
         потерять питание.
         
         TRUNCATE — хороший компромисс:
         - Быстрее DELETE (не нужно удалять файл журнала)
         - Безопаснее MEMORY (данные на диске)
         - Меньше фрагментации чем PERSIST на eMMC
         - Меньше операций записи чем DELETE (дольше жизнь eMMC) -->
    <string name="db_default_journal_mode">TRUNCATE</string>

    <!-- Синхронизация в режиме журнала по умолчанию.
         ИСПРАВЛЕНО: было OFF — риск повреждения данных!
         NORMAL — оптимальный баланс:
         - Одна fsync на транзакцию вместо двух (FULL)
         - Защита целостности данных сохранена
         - В 2-3 раза быстрее FULL
         - Достаточно надёжно для мобильного устройства -->
    <string name="db_default_sync_mode">NORMAL</string>

    <!-- Синхронизация WAL режима.
         ИСПРАВЛЕНО: было OFF — совершенно недопустимо для WAL!
         WAL с sync=OFF может потерять последние N транзакций при crash.
         NORMAL — рекомендуемый SQLite для WAL режима:
         - WAL уже обеспечивает атомарность
         - NORMAL достаточно для целостности
         - Минимальное влияние на производительность по сравнению с OFF
         - Драматическое улучшение надёжности -->
    <string name="db_wal_sync_mode">NORMAL</string>

    <!-- ======================== -->
    <!-- LED И HAPTIC             -->
    <!-- ======================== -->

    <!-- LED уведомлений — назойливый, показать опцию отключения -->
    <bool name="config_intrusiveNotificationLed">true</bool>

    <!-- Многоцветный LED батареи -->
    <bool name="config_multiColorBatteryLed">true</bool>

    <!-- Тактильная обратная связь при перемещении курсора.
         ОТКЛЮЧЕНО — на 3/32 устройстве каждая вибрация это:
         1. Задержка в обработке событий касания
         2. Дополнительный wakelock
         3. Потребление батареи -->
    <bool name="config_enableHapticTextHandle">false</bool>

    <!-- ======================== -->
    <!-- АУДИО                    -->
    <!-- ======================== -->

    <!-- Использовать /dev/input/event для обнаружения гарнитуры -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Безопасная громкость наушников. Без изменений -->
    <integer name="config_safe_media_volume_index">8</integer>

    <!-- Поддержка необработанного аудиоисточника -->
    <bool name="config_supportAudioSourceUnprocessed">true</bool>

    <!-- Ускорение аудио при входящих вызовах -->
    <bool name="config_speed_up_audio_on_mt_calls">true</bool>

    <!-- Разделение громкости звонка и уведомлений.
         false = раздельное управление, более гибко -->
    <bool name="config_alias_ring_notif_stream_types">false</bool>

    <!-- ======================== -->
    <!-- ПИТАНИЕ И БАТАРЕЯ        -->
    <!-- ======================== -->

    <!-- Включение экрана при отключении зарядки -->
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- Крышка управляет сном (для чехлов с магнитом) -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- Засыпание при срабатывании датчика приближения.
         Включено — экономит батарею при звонках -->
    <bool name="config_suspendWhenScreenOffDueToProximity">true</bool>

    <!-- Daydream (заставки) ОТКЛЮЧЕНЫ по умолчанию.
         На 3GB RAM заставки — это бесполезный расход ресурсов -->
    <bool name="config_dreamsEnabledByDefault">false</bool>

    <!-- Doze компонент -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>

    <!-- Doze запускается после анимации выключения экрана -->
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>

    <!-- Always On Display ДОСТУПЕН (но отключён по умолчанию ниже) -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>

    <!-- AOD ОТКЛЮЧЁН по умолчанию.
         На IPS дисплее markw AOD потребляет значительную мощность
         (подсвечивается вся матрица). Пользователь может включить вручную -->
    <bool name="config_dozeAlwaysOnEnabled">false</bool>

    <!-- Экран не гаснет при переходе из doze — корректно для IPS -->
    <bool name="config_displayBlanksAfterDoze">false</bool>

    <!-- Предупреждение о низком заряде: 15% — оптимально для 4100mAh -->
    <integer name="config_lowBatteryWarningLevel">15</integer>

    <!-- Критический уровень заряда.
         Увеличено с 8% до 5%.
         5% от 4100mAh = ~205mAh — достаточно для корректного shutdown.
         8% зарезервировано слишком много -->
    <integer name="config_criticalBatteryWarningLevel">5</integer>

    <!-- Smart Battery — адаптивное управление батареей -->
    <bool name="config_smart_battery_available">true</bool>

