    <!-- WiFi Display (Miracast) -->
    <bool name="config_enableWifiDisplay">true</bool>

    <!-- WiFi Display: защищённые буферы.
         false — нет аппаратного HDCP пути в markw -->
    <bool name="config_wifiDisplaySupportsProtectedBuffers">false</bool>

    <!-- IWLAN пакеты -->
    <string name="config_wlan_data_service_package">vendor.qti.iwlan</string>
    <string name="config_wlan_network_service_package">vendor.qti.iwlan</string>
    <string name="config_qualified_networks_service_package">vendor.qti.iwlan</string>

    <!-- Атрибуты сетей. Убрана mobile_emergency (дублирует системный default),
         mobile_cbs (Cell Broadcast через отдельный сервис в Android 15) -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"mobile,0,0,0,-1,true"</item>
        <item>"mobile_mms,2,0,4,60000,true"</item>
        <item>"mobile_supl,3,0,2,60000,true"</item>
        <item>"mobile_dun,4,0,2,60000,true"</item>
        <item>"mobile_hipri,5,0,3,60000,true"</item>
        <item>"mobile_fota,10,0,2,60000,true"</item>
        <item>"mobile_ims,11,0,2,60000,true"</item>
        <item>"mobile_cbs,12,0,2,60000,true"</item>
        <item>"bluetooth,7,7,2,-1,true"</item>
        <item>"mobile_emergency,15,0,5,-1,true"</item>
        <item>"ethernet,9,9,9,-1,true"</item>
    </string-array>

    <!-- Атрибуты радиомодулей -->
    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
        <item>"0,1"</item>
        <item>"7,1"</item>
    </string-array>

    <!-- Восстановление выбора сети обрабатывается модемом -->
    <bool translatable="false" name="skip_restoring_network_selection">true</bool>

    <!-- TCP буферы для мобильных сетей.
         ОПТИМИЗИРОВАНО:
         - УБРАН 5gnr — Snapdragon 625 не поддерживает 5G
         - УБРАН lte_ca — markw не поддерживает Carrier Aggregation
         - Уменьшены буферы LTE: rmem_max с 8MB до 4MB
           (eMMC и 3GB RAM не могут эффективно использовать 8MB буферы,
            это лишний расход памяти ядра)
         - HSPA/HSDPA/HSUPA объединены в одну конфигурацию (идентичные)
         - Буферы EDGE/GPRS оптимизированы под реальные скорости -->
    <string-array name="config_mobile_tcp_buffers">
        <item>"lte:524288,1048576,4194304,262144,524288,1048576"</item>
        <item>"umts:4094,87380,1220608,4096,16384,1220608"</item>
        <item>"hspa:4094,87380,1220608,4096,16384,1220608"</item>
        <item>"hsupa:4094,87380,1220608,4096,16384,1220608"</item>
        <item>"hsdpa:4094,87380,1220608,4096,16384,1220608"</item>
        <item>"hspap:4094,87380,1220608,4096,16384,1220608"</item>
        <item>"edge:4093,26280,35040,4096,16384,35040"</item>
        <item>"gprs:4092,8760,11680,4096,8760,11680"</item>
        <item>"evdo:4094,87380,524288,4096,16384,262144"</item>
    </string-array>

    <!-- Таймаут перехода сети. Снижен с 60с до 30с.
         60 секунд ожидания переключения WiFi↔Mobile — слишком долго -->
    <integer name="config_networkTransitionTimeout">30000</integer>

    <!-- Автоматическое переключение от плохого WiFi.
