on early-init
    # Кратковременный sched boost только на время загрузки
    write /proc/sys/kernel/sched_boost 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    mount_all /vendor/etc/fstab.qcom

    chown root system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0700 system system
    mkdir /mnt/vendor/persist/bms 0700 root system

on early-boot
    chown system system /mnt/vendor/persist/sensors
    chown system system /mnt/vendor/persist/sensors/sns.reg
    chown system system /mnt/vendor/persist/sensors/sensors_list.txt
    chown system system /mnt/vendor/persist/sensors/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry
    chown system system /mnt/vendor/persist/sensors/registry/registry/sensors_registry
    chown system system /mnt/vendor/persist/sensors/sensors_settings
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_config
    chown system system /mnt/vendor/persist/sensors/registry/sns_reg_version
    chown system system /mnt/vendor/persist/sensors/registry/config
    chmod 0664 /mnt/vendor/persist/sensors/sensors_settings

on init
    write /sys/module/qpnp_rtc/parameters/poweron_alarm 1

on post-fs
    setrlimit 8 67108864 67108864

    # ═══════════════════════════════════════════════════════════════
    # СТАРТ КРИПТОГРАФИИ ДЛЯ FBE V1 (ДО post-fs-data!)
    # ═══════════════════════════════════════════════════════════════
    # 1. Запускаем демон доверенной зоны (QSEECOM)
    start vendor.qseecomd
    
    # 2. Блокируем дальнейший init, пока QSEECOMD не зарегистрирует слушателей ключей
    wait_for_prop vendor.sys.listeners.registered true
    
    # 3. Принудительно стартуем Keymaster 3.0 и Gatekeeper 1.0 на этапе post-fs.
    #    Это гарантирует, что к моменту старта vold (в post-fs-data) они будут
    #    полностью готовы отдавать ключи FBE.
    start vendor.keymaster-3-0
    start vendor.gatekeeper-1-0

    write /dev/ipa 1

    # ═══════════════════════════════════════════════════════════════
    # VM TUNING — Ядро 4.9, 3GB ОЗУ (без параметров из будущих ядер)
    # ═══════════════════════════════════════════════════════════════
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/dirty_ratio 15
    write /proc/sys/vm/dirty_expire_centisecs 3000
    write /proc/sys/vm/dirty_writeback_centisecs 1500
    write /proc/sys/vm/vfs_cache_pressure 80
    write /proc/sys/vm/min_free_kbytes 12288
    write /proc/sys/vm/extra_free_kbytes 4096
    write /proc/sys/vm/watermark_scale_factor 50
    write /proc/sys/vm/laptop_mode 0
    
    # Отключение автоматической дефрагментации ОЗУ (сохраняет ядра A53)
    write /proc/sys/vm/compaction_proactiveness 0

on post-fs-data
    mkdir /data/vendor/qcam/ 0770 camera camera

# Peripheral manager
service vendor.per_mgr /vendor/bin/pm-service
    class core
    user system
    group system net_raw
    ioprio rt 4
    task_profiles ServiceCapacityLow

service vendor.per_proxy /vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled
    task_profiles ServiceCapacityLow

on property:init.svc.vendor.per_mgr=running
    start vendor.per_proxy

on property:sys.shutdown.requested=*
    stop vendor.per_proxy
    stop vendor.ims_rtp_daemon

service vendor.qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root
    task_profiles ServiceCapacityLow

service thermal-engine /vendor/bin/thermal-engine
    class main
    user root
    group root
    socket thermal-send-client stream 0660 system oem_2907
    socket thermal-recv-client stream 0660 system oem_2907
    socket thermal-recv-passive-client stream 0660 system oem_2907
    socket thermal-send-rule stream 0660 system oem_2907

on property:sys.boot_completed=1
    restart thermal-engine

service wcnss-service /vendor/bin/wcnss_service
    class main
    user system
    group system wifi radio
    oneshot
    task_profiles ServiceCapacityLow

service vendor.hvdcp_opti /vendor/bin/hvdcp_opti
    class main
    user root
    group system wakelock

on property:init.svc.vendor.charger=running
    write /sys/devices/system/cpu/cpu2/online 0
    write /sys/devices/system/cpu/cpu3/online 0
    write /sys/module/lpm_levels/parameters/sleep_disabled 0
    start vendor.hvdcp_opti
    start vendor.power_off_alarm
    start thermal-engine

on boot
    # Разрешаем изменять инпут буст системе
    chown system system /sys/module/cpu_boost/parameters/input_boost_freq
    chown system system /sys/module/cpu_boost/parameters/input_boost_ms
    chmod 0664 /sys/module/cpu_boost/parameters/input_boost_freq
    chown system system /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq
    
    # Права для cpuset
    mkdir /dev/cpuset/top-app
    chown system system /dev/cpuset/top-app
    chown system system /dev/cpuset/top-app/tasks
    chmod 0664 /dev/cpuset/top-app/tasks
    
    chown system system /mnt/vendor/persist/WCNSS_qcom_wlan_nv.bin

    # USB controller configuration
    setprop vendor.usb.rndis.func.name "rndis"
    setprop vendor.usb.rmnet.func.name "rmnet_bam"
    setprop vendor.usb.rmnet.inst.name "rmnet_bam_dmux"
    setprop vendor.usb.dpl.inst.name "dpl_bam_dmux"
    setprop vendor.usb.qdss.inst.name "qdss"

service vendor-sensor-sh /vendor/bin/init.qcom.sensors.sh
    class core
    user root
    oneshot

service vendor.sensors.qti /vendor/bin/sensors.qti
    class core
    user system
    group system
    task_profiles ServiceCapacityLow

# USB product string
on property:ro.product.vendor.model=*
    setprop vendor.usb.product_string ${ro.product.vendor.model}
