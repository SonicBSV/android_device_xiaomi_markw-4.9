import /vendor/etc/init/hw/init.qcom.usb.rc
import /vendor/etc/init/hw/init.msm.usb.configfs.rc
import /vendor/etc/init/hw/init.target.rc
import /vendor/etc/init/hw/init.parts.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chmod 0755 /sys/kernel/debug
    chown root system /dev/kmsg
    chmod 0620 /dev/kmsg

on init
    # ═══════════════════════════════════════════════════════════════
    # CGROUPS V1 — Инициализация и исправление прав (Kernel 4.9)
    # ═══════════════════════════════════════════════════════════════

    # 1. Freezer v1 (Заморозка фоновых процессов)
    mkdir /sys/fs/cgroup/freezer 0750 root system
    mount cgroup none /sys/fs/cgroup/freezer freezer
    # Исправление прав после монтирования
    chown system system /sys/fs/cgroup/freezer
    chmod 0755 /sys/fs/cgroup/freezer
    chown system system /sys/fs/cgroup/freezer/tasks
    chmod 0660 /sys/fs/cgroup/freezer/tasks
    chown system system /sys/fs/cgroup/freezer/cgroup.procs
    chmod 0660 /sys/fs/cgroup/freezer/cgroup.procs

    # 2. Memory cgroup v1 (memcg — КРИТИЧЕСКОЕ ИСПРАВЛЕНИЕ)
    mkdir /dev/memcg 0700 system system
    mount cgroup none /dev/memcg memory
    # Назначаем владельцем "system", чтобы system_server мог создавать/удалять папки внутри
    chown system system /dev/memcg
    chmod 0755 /dev/memcg
    chown system system /dev/memcg/tasks
    chmod 0660 /dev/memcg/tasks
    chown system system /dev/memcg/cgroup.procs
    chmod 0660 /dev/dev/memcg/cgroup.procs

    # Создаем подкаталог для фоновых служб (bg)
    mkdir /dev/memcg/bg 0750 system system
    chown system system /dev/memcg/bg
    chown system system /dev/memcg/bg/tasks
    chmod 0660 /dev/memcg/bg/tasks
    chown system system /dev/memcg/bg/cgroup.procs
    chmod 0660 /dev/memcg/bg/cgroup.procs
    write /dev/memcg/bg/memory.swappiness 100
    write /dev/memcg/bg/memory.move_charge_at_immigrate 1

    # 3. CPU cgroup v1 подкаталоги (синхронизировано с task_profiles.json)
    #    Каждому подкаталогу и его файлам выдаются права на запись для system
    mkdir /dev/cpuctl/top-app 0755 system system
    chown system system /dev/cpuctl/top-app
    chown system system /dev/cpuctl/top-app/tasks
    chown system system /dev/cpuctl/top-app/cgroup.procs
    chmod 0664 /dev/cpuctl/top-app/tasks
    chmod 0664 /dev/cpuctl/top-app/cgroup.procs
    write /dev/cpuctl/top-app/cpu.shares 1024

    mkdir /dev/cpuctl/foreground 0755 system system
    chown system system /dev/cpuctl/foreground
    chown system system /dev/cpuctl/foreground/tasks
    chown system system /dev/cpuctl/foreground/cgroup.procs
    chmod 0664 /dev/cpuctl/foreground/tasks
    chmod 0664 /dev/cpuctl/foreground/cgroup.procs
    write /dev/cpuctl/foreground/cpu.shares 512

    mkdir /dev/cpuctl/background 0755 system system
    chown system system /dev/cpuctl/background
    chown system system /dev/cpuctl/background/tasks
    chown system system /dev/cpuctl/background/cgroup.procs
    chmod 0664 /dev/cpuctl/background/tasks
    chmod 0664 /dev/cpuctl/background/cgroup.procs
    write /dev/cpuctl/background/cpu.shares 128

    mkdir /dev/cpuctl/rt 0755 system system
    chown system system /dev/cpuctl/rt
    chown system system /dev/cpuctl/rt/tasks
    chown system system /dev/cpuctl/rt/cgroup.procs
    chmod 0664 /dev/cpuctl/rt/tasks
    chmod 0664 /dev/cpuctl/rt/cgroup.procs
    write /dev/cpuctl/rt/cpu.shares 1024

    # 4. BLKIO cgroup v1 (Приоритезация диска eMMC)
    mkdir /dev/blkio 0755 root system
    mount cgroup none /dev/blkio blkio
    # Назначаем права после монтирования
    chown system system /dev/blkio
    chmod 0755 /dev/blkio
    chown system system /dev/blkio/tasks
    chmod 0664 /dev/blkio/tasks
    chown system system /dev/blkio/cgroup.procs
    chmod 0664 /dev/blkio/cgroup.procs

    # Фоновая группа ввода-вывода (bg)
    mkdir /dev/blkio/bg 0755 system system
    chown system system /dev/blkio/bg
    chown system system /dev/blkio/bg/tasks
    chown system system /dev/blkio/bg/cgroup.procs
    chmod 0664 /dev/blkio/bg/tasks
    chmod 0664 /dev/blkio/bg/cgroup.procs
    write /dev/blkio/blkio.weight 1000
    write /dev/blkio/bg/blkio.weight 100

    # ═══════════════════════════════════════════════════════════════
    # Subsystem restart policy
    # ═══════════════════════════════════════════════════════════════
    write /sys/bus/msm_subsys/devices/subsys0/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys1/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys2/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys3/restart_level RELATED
    write /sys/bus/msm_subsys/devices/subsys4/restart_level RELATED

    # ═══════════════════════════════════════════════════════════════
    # ZRAM Base Config (swapon в post-fs-data)
    # ═══════════════════════════════════════════════════════════════
    write /sys/block/zram0/comp_algorithm lz4
    write /sys/block/zram0/max_comp_streams 4
    write /proc/sys/vm/page-cluster 0

    # Блокируем ZRAM Writeback на eMMC
    write /sys/block/zram0/writeback_limit_enable 0
    write /sys/block/zram0/writeback_limit 0

on early-boot
    # Allow subsystem (modem etc) debugging
    write /sys/kernel/boot_adsp/boot 1

    exec u:r:vendor_qti_init_shell:s0 -- /vendor/bin/init.qcom.early_boot.sh

    # Graphics
    chown system graphics /sys/class/graphics/fb0/idle_time
    chmod 0664 /sys/class/graphics/fb0/idle_time
    chown system graphics /sys/class/graphics/fb0/dynamic_fps
    chmod 0664 /sys/class/graphics/fb0/dynamic_fps
    chown system graphics /sys/class/graphics/fb0/dyn_pu
    chmod 0664 /sys/class/graphics/fb0/dyn_pu
    chown system graphics /sys/class/graphics/fb0/modes
    chmod 0664 /sys/class/graphics/fb0/modes
    chown system graphics /sys/class/graphics/fb0/mode
    chmod 0664 /sys/class/graphics/fb0/mode
    chown system graphics /sys/class/graphics/fb0/msm_cmd_autorefresh_en
    chmod 0664 /sys/class/graphics/fb0/msm_cmd_autorefresh_en

on boot
    chown system system /sys/bus/i2c/devices/3-0038/set_cover_mode
    chmod 0660 /sys/bus/i2c/devices/3-0038/set_cover_mode
    chown system system /sys/kernel/boot_slpi/ssr
    chown system system /sys/kernel/boot_adsp/ssr

    write /proc/sys/kernel/random/read_wakeup_threshold 64
    write /proc/sys/kernel/random/write_wakeup_threshold 128

    # Power HAL / libperfmgr permissions
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    chown system system /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq

    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/max_freq

    chown system system /sys/class/devfreq/soc:qcom,cpubw/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,cpubw/min_freq
    chown system system /sys/class/devfreq/soc:qcom,gpubw/min_freq
    chmod 0664 /sys/class/devfreq/soc:qcom,gpubw/min_freq

    chown system system /dev/stune/top-app/schedtune.boost
    chmod 0664 /dev/stune/top-app/schedtune.boost

    # DT2W gesture
    chmod 0660 /proc/gesture/onoff
    chown system system /proc/gesture/onoff

    # QCRIL IPC sockets
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio

    mkdir /persist/drm 0770 system system
    mkdir /mnt/vendor/persist/bluetooth 0770 bluetooth bluetooth
    mkdir /persist/misc 0770 system system
    mkdir /persist/alarm 0770 system system
    mkdir /mnt/vendor/persist/time 0770 system system
    mkdir /mnt/vendor/persist/secnvm 0770 system system

    setprop wifi.interface wlan0

    chmod 0755 /system/bin/ip
    chmod 0444 /sys/devices/platform/msm_hsusb/gadget/usb_state

    # Prevent OOO acks from breaking conntrack
    write /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 1

    chown wifi wifi /sys/module/wlan/parameters/fwpath

    mkdir /mnt/vendor/persist/hvdcp_opti 0770 root system

on post-fs-data
    mkdir /data/vendor/misc 01771 system system
    mkdir /data/vendor/ssrdump 0770 root system
    mkdir /data/vendor/display 0770 system graphics
    mkdir /data/vendor/media 0770 mediacodec media
    mkdir /data/vendor/ramdump 0771 root system
    mkdir /data/vendor/bluetooth 0770 bluetooth bluetooth
    mkdir /data/vendor/ramdump/bluetooth 0770 bluetooth bluetooth
    mkdir /data/vendor/tombstones 0771 system system
    mkdir /data/vendor/tombstones/rfs 0771 system system

    # WiFi directories
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/ctrl 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa_supplicant 0770 wifi wifi

    # CnE
    mkdir /data/vendor/connectivity 0771 radio radio
    chown radio radio /data/vendor/connectivity

    # Radio
    mkdir /data/vendor/radio 0770 system radio
    mkdir /data/vendor/modem_config 0570 radio root

    chown system system /persist/WCNSS_qcom_wlan_nv.bin

    # Location
    mkdir /data/vendor/location 0770 gps gps
    mkdir /data/vendor/location/mq 0770 gps gps
    mkdir /data/vendor/location/xtwifi 0770 gps gps
    mkdir /dev/socket/location 0770 gps gps
    mkdir /dev/socket/location/mq 0770 gps gps
    mkdir /dev/socket/location/xtra 0770 gps gps
    mkdir /dev/socket/location/ehub 0770 gps gps
    mkdir /dev/socket/location/dgnss 0770 gps gps

    # WiFi HAL
    mkdir /dev/socket/wifihal 0770 wifi wifi
    chmod 2770 /dev/socket/wifihal

    mkdir /data/vendor/time 0700 system system

    # Audio
    mkdir /data/vendor/audio 0770 audio audio
    mkdir /data/vendor/audio/acdbdata 0770 media audio
    mkdir /data/vendor/audio/acdbdata/delta 0770 media audio

    # FM
    mkdir /data/vendor/fm 0770 system system
    chmod 0770 /data/vendor/fm

    # PERFD compat
    mkdir /data/vendor/perfd 0770 root system
    chmod 2770 /data/vendor/perfd
    rm /data/vendor/perfd/default_values

    # Secure Element
    mkdir /data/vendor/secure_element 0770 secure_element secure_element

    # TUI
    mkdir /data/vendor/tui 0700 system drmrpc

    # Radio DB
    write /data/vendor/radio/copy_complete 0
    chown radio radio /data/vendor/radio/copy_complete
    chmod 0660 /data/vendor/radio/copy_complete
    copy /vendor/radio/qcril_database/qcril.db /data/vendor/radio/qcril_prebuilt.db
    chown radio radio /data/vendor/radio/qcril_prebuilt.db
    chmod 0660 /data/vendor/radio/qcril_prebuilt.db
    write /data/vendor/radio/prebuilt_db_support 1
    chown radio radio /data/vendor/radio/prebuilt_db_support
    chmod 0400 /data/vendor/radio/prebuilt_db_support
    write /data/vendor/radio/db_check_done 0
    chown radio radio /data/vendor/radio/db_check_done
    chmod 0660 /data/vendor/radio/db_check_done

    # Включение ZRAM свопа в самом начале post-fs-data
    swapon_all /vendor/etc/fstab.zram
    write /proc/sys/vm/swappiness 100

    # Must be last
    setprop vold.post_fs_data_done 1

# Ранний запуск qcom-post-boot (настройка процессора и планировщика I/O)
on property:vold.post_fs_data_done=1
    start qcom-post-boot

# Boot completed — минимальные действия
on property:sys.boot_completed=1
    setprop vendor.powerhal.init 1
    write /dev/kmsg "Boot completed "
    start vendor.camera.provider

# DSDS — Перезапуск qcrild при смене активной карты
on property:persist.sys.radio.mobile_data_swap=1
    exec /bin/sleep 3s
    restart vendor.qcrild
    restart vendor.qcrild2

# FM
on property:hw.fm.init=0
    write /sys/module/radio_iris_transport/parameters/fmsmd_set 0

on property:hw.fm.init=1
    write /sys/module/radio_iris_transport/parameters/fmsmd_set 1

on property:vendor.media.target.version=*
    setprop vendor.sys.media.target.version ${vendor.media.target.version}

on property:vendor.netflix.bsp_rev=*
    setprop ro.netflix.bsp_rev ${vendor.netflix.bsp_rev}

# ========================
# SERVICES
# ========================

service qcom-c_main-sh /vendor/bin/init.class_main.sh
    class main
    user root
    group root system
    oneshot

service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    class core
    user vendor_qrtr
    group vendor_qrtr
    capabilities NET_BIND_SERVICE

service irsc_util /vendor/bin/irsc_util "/vendor/etc/sec_config"
    class core
    user root
    oneshot

service loc_launcher /vendor/bin/loc_launcher
    class late_start
    user gps
    group gps
    task_profiles ServiceCapacityLow

service qcom-sh /vendor/bin/init.qcom.sh
    class late_start
    user root
    group root system radio
    oneshot

on property:ro.vendor.ril.mbn_copy_completed=1
    write /data/vendor/radio/copy_complete 1

service qcom-post-boot /vendor/bin/init.qcom.post_boot.sh
    class main
    user root
    group root system wakelock graphics
    disabled
    oneshot

service vendor.msm_irqbalance /vendor/bin/msm_irqbalance -f /vendor/etc/msm_irqbalance.conf
    class core
    user root
    group root
    task_profiles ServiceCapacityLow

on property:init.svc.vendor.charger=running
    start qcom-post-boot

service vendor.audio-hal /vendor/bin/hw/android.hardware.audio.service
    override
    class hal
    user audioserver
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct oem_2901 wakelock context_hub
    capabilities BLOCK_SUSPEND
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    socket audio_hw_socket seqpacket 0666 system system
    onrestart restart audioserver

service vendor.power_off_alarm /vendor/bin/power_off_alarm
    class core
    group system
    disabled
    oneshot

service sensors-hal-1-0 /vendor/bin/hw/android.hardware.sensors@1.0-service
    override
    class hal
    user system
    group system wakelock uhid input context_hub
    capabilities BLOCK_SUSPEND
    rlimit rtprio 10 10
