service vendor.light-default /vendor/bin/hw/android.hardware.light-service.xiaomi_markw
    class hal
    user system
    group system
    shutdown critical

on boot
    # RGB leds
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/red/blink
    chown system system /sys/class/leds/red/on_off_ms
    chmod 0664 /sys/class/leds/red/brightness
    chmod 0664 /sys/class/leds/red/blink
    chmod 0664 /sys/class/leds/red/on_off_ms

    chown system system /sys/class/leds/green/brightness
    chown system system /sys/class/leds/green/blink
    chown system system /sys/class/leds/green/on_off_ms
    chmod 0664 /sys/class/leds/green/brightness
    chmod 0664 /sys/class/leds/green/blink
    chmod 0664 /sys/class/leds/green/on_off_ms

    chown system system /sys/class/leds/blue/brightness
    chown system system /sys/class/leds/blue/blink
    chown system system /sys/class/leds/blue/on_off_ms
    chmod 0664 /sys/class/leds/blue/brightness
    chmod 0664 /sys/class/leds/blue/blink
    chmod 0664 /sys/class/leds/blue/on_off_ms

    # Backlight via leds class (optional, some devices have it)
    chown system system /sys/class/leds/lcd-backlight/brightness
    chmod 0664 /sys/class/leds/lcd-backlight/brightness

    # Backlight via backlight class (optional)
    chown system system /sys/class/backlight/panel0-backlight/brightness
    chmod 0664 /sys/class/backlight/panel0-backlight/brightness
    chown system system /sys/class/backlight/backlight/brightness
    chmod 0664 /sys/class/backlight/backlight/brightness
