typeattribute vendor_init data_between_core_and_vendor_violators;

allow vendor_init self:capability kill;

allow vendor_init {
  bluetooth_data_file
  vendor_camera_data_file
  media_rw_data_file
  system_data_file
  tombstone_data_file
  vendor_time_data_file
  wifi_data_file
  wpa_socket
}:dir { create search getattr open read setattr ioctl write add_name remove_name rmdir relabelfrom };

allow vendor_init {
   device
   media_rw_data_file
   proc_sched
}:file { create getattr open read setattr ioctl write relabelfrom };

set_prop(vendor_init, camera_prop)

get_prop(vendor_init, vendor_fingerprint_prop)
set_prop(vendor_init, vendor_fingerprint_prop)

get_prop(vendor_init, vendor_dataqdp_prop)
set_prop(vendor_init, vendor_dataqdp_prop)

dontaudit vendor_init default_prop:property_service { set };
dontaudit vendor_init default_prop:file { read open };
allow vendor_init { fpc_data_file gx_fpd_data_file }:dir create_dir_perms;

allow vendor_init gx_fpd_data_file:dir search;
allow vendor_init gx_fpd_data_file:file getattr;
