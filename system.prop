#
# system.prop for markw
#

# Audio
ro.config.media_vol_steps=25
ro.config.vc_call_vol_steps=11
ro.config.alarm_vol_steps=25

# Dexopt
dalvik.vm.dex2oat64.enabled=true
pm.dexopt.shared=speed

# MTE
arm64.memtag.process.system_server=off

# Sleep
pm.sleep_mode=1

# Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

# FM
ro.fm.transmitter=false

# HWUI (tuned for 3GB / 1080p / Adreno 506)
ro.hwui.texture_cache_size=48
ro.hwui.layer_cache_size=32
ro.hwui.r_buffer_cache_size=6
ro.hwui.path_cache_size=24
ro.hwui.drop_shadow_cache_size=4
ro.hwui.texture_cache_flushrate=0.5
ro.hwui.text_small_cache_width=1024
ro.hwui.text_small_cache_height=1024
ro.hwui.text_large_cache_width=2048
ro.hwui.text_large_cache_height=2048

# Display
debug.hwui.use_hint_manager=true
debug.mdpcomp.logs=0
debug.sf.enable_transaction_tracing=false
debug.sf.latch_unsignaled=1
dev.pm.dyn_samplingrate=1
persist.demo.hdmirotationlock=false
persist.hwc.mdpcomp.enable=true
ro.egl.blobcache.multifile=true
ro.egl.blobcache.multifile_limit=33554432

# Media
av.debug.disable.pers.cache=1
media.aac_51_output_enabled=true
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
media.stagefright.thumbnail.prefer_hw_codecs=true
mmp.enable.3g2=true

# Transcoding
persist.sys.fuse.transcode_user_control=true
persist.sys.fuse.transcode_enabled=false

# Shutdown
ro.build.shutdown_timeout=5
ro.hw_timeout_multiplier=2

# SurfaceFlinger
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096

# System
persist.sys.binary_xml=false

# Time
persist.backup.ntpServer=0.pool.ntp.org
persist.timed.enable=true

# Telephony
ro.telephony.call_ring.multiple=false
ro.telephony.default_network=20,20
service.qti.ims.enabled=1

# WiFi
persist.mm.sta.enable=0

# WFD
persist.hwc.enable_vds=1

# Zygote
zygote.critical_window.minute=10
